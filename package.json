{
  "name": "fauzi-portfolio",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @portfolio/web --filter @portfolio/api dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm --filter @portfolio/api test",
    "test:security": "node scripts/security-smoke.mjs",
    "test:traffic": "node scripts/traffic-test.mjs",
    "db:generate": "pnpm --filter @portfolio/api db:generate",
    "db:migrate": "pnpm --filter @portfolio/api db:migrate",
    "db:seed": "pnpm --filter @portfolio/api db:seed",
    "db:studio": "pnpm --filter @portfolio/api db:studio",
    "storage:setup": "pnpm --filter @portfolio/api storage:setup"
  }
}
